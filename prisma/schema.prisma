generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  type      String
  subject   String?
  message   String
  org       String?
  phone     String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}
